   "source": [
    "daily_product = (\n",
    "    df.groupby([\"date\", \"product_name\"])[\"revenue\"]\n",
    "    .sum()\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "top_products = (\n",
    "    daily_product.groupby(\"product_name\")[\"revenue\"]\n",
    "    .sum()\n",
    "    .nlargest(8)\n",
    "    .index\n",
    ")\n",
    "\n",
    "daily_product = daily_product[\n",
    "    daily_product[\"product_name\"].isin(top_products)\n",
    "]\n",
    "\n",
    "daily_product_table = daily_product.pivot(\n",
    "    index=\"date\",\n",
    "    columns=\"product_name\",\n",
    "    values=\"revenue\"\n",
    ").fillna(0)\n",
    "\n",
    "display(daily_product_table.round(2))"
   ]
