    "from mpl_toolkits.mplot3d import Axes3D\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "category_revenue = (\n",
    "    df.groupby(\"category\")[\"revenue\"]\n",
    "    .mean()\n",
    "    .sort_values(ascending=False)\n",
    ")\n",
    "\n",
    "labels = category_revenue.index\n",
    "values = category_revenue.values\n",
    "\n",
    "colors = [\n",
    "    \"#0F766E\",\n",
    "    \"#2563EB\",\n",
    "    \"#84A329\",\n",
    "    \"#F59E0B\",\n",
    "    \"#C2410C\"\n",
    "]\n",
    "\n",
    "fig = plt.figure(figsize=(12, 7))\n",
    "ax = fig.add_subplot(111, projection=\"3d\")\n",
    "\n",
    "x = np.arange(len(labels))\n",
    "y = np.zeros(len(labels))\n",
    "z = np.zeros(len(labels))\n",
    "\n",
    "dx = 0.65\n",
    "dy = 0.8\n",
    "\n",
    "for i in range(len(values)):\n",
    "    ax.bar3d(\n",
    "        x[i], y[i], z[i],\n",
    "        dx, dy, values[i],\n",
    "        color=colors[i % len(colors)],\n",
    "        shade=True,\n",
    "        edgecolor=\"white\",\n",
    "        linewidth=1.2\n",
    "    )\n",
    "\n",
    "    ax.text(\n",
    "        x[i] + dx / 2,\n",
    "        y[i] + dy / 2,\n",
    "        values[i] * 0.5,\n",
    "        f\"₹{values[i]:,.0f}\",\n",
    "        ha=\"center\",\n",
    "        va=\"center\",\n",
    "        fontsize=11,\n",
    "        fontweight=\"bold\",\n",
    "        color=\"white\"\n",
    "    )\n",
    "\n",
    "    ax.text(\n",
    "        x[i] + dx / 2,\n",
    "        y[i] + dy / 2,\n",
    "        values[i] + 100,\n",
    "        labels[i],\n",
    "        ha=\"center\",\n",
    "        va=\"bottom\",\n",
    "        fontsize=11,\n",
    "        fontweight=\"bold\"\n",
    "    )\n",
    "\n",
    "ax.set_xticks(x + dx / 2)\n",
    "ax.set_xticklabels(labels, fontsize=11)\n",
    "\n",
    "ax.set_yticks([])\n",
    "\n",
    "ax.set_xlabel(\n",
    "    \"Category\",\n",
    "    fontsize=11,\n",
    "    fontweight=\"bold\",\n",
    "    labelpad=12\n",
    ")\n",
    "\n",
