    "## 3. Product Contribution"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c9afe7f3",
   "metadata": {},
   "source": [
    "### ASHIKA — TASK CONTINUATION\n",
    "\n",
    "**Product Contribution Analysis:** Continued analyzing **product-wise contribution**, **category-wise product performance**, and identifying **top & bottom-performing products** to derive key business insights."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9bd0fdb1",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1600x1560 with 5 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.colors import hsv_to_rgb\n",
    "\n",
    "df = pd.read_csv(\"MUC01_Retail_Sales_Dataset 1.csv\")\n",
    "\n",
    "df[\"revenue\"] = pd.to_numeric(df[\"revenue\"], errors=\"coerce\")\n",
    "df[\"category\"] = df[\"category\"].astype(str).str.strip()\n",
    "df[\"product_name\"] = df[\"product_name\"].astype(str).str.strip()\n",
    "\n",
    "df = df.dropna(\n",
    "    subset=[\"category\", \"product_name\", \"revenue\"]\n",
    ")\n",
    "\n",
    "category_product = (\n",
    "    df.groupby(\n",
    "        [\"category\", \"product_name\"],\n",
    "        as_index=False\n",
    "    )[\"revenue\"]\n",
    "    .sum()\n",
    ")\n",
    "\n",
    "category_totals = (\n",
    "    category_product\n",
    "    .groupby(\"category\")[\"revenue\"]\n",
    "    .transform(\"sum\")\n",
    ")\n",
    "\n",
    "category_product[\"revenue_share\"] = (\n",
    "    category_product[\"revenue\"]\n",
    "    / category_totals\n",
    "    * 100\n",
    ")\n",
    "\n",
    "category_product = category_product.sort_values(\n",
    "    [\"category\", \"revenue_share\"],\n",
    "    ascending=[True, False]\n",
    ")\n",
    "\n",
    "all_products = (\n",
    "    category_product[\"product_name\"]\n",
    "    .drop_duplicates()\n",
    "    .tolist()\n",
    ")\n",
    "\n",
    "n_products = len(all_products)\n",
    "\n",
    "product_colors = {}\n",
    "\n",
    "for i, product in enumerate(all_products):\n",
    "    hue = i / max(n_products, 1)\n",
    "\n",
    "    product_colors[product] = hsv_to_rgb(\n",
    "        [hue, 0.70, 0.85]\n",
    "    )\n",
    "\n",
    "categories = sorted(\n",
    "    category_product[\"category\"].unique()\n",
    ")\n",
    "\n",
    "n_categories = len(categories)\n",
    "\n",
    "n_cols = 2\n",
    "n_rows = int(np.ceil(n_categories / n_cols))\n",
    "\n",
    "fig, axes = plt.subplots(\n",
    "    n_rows,\n",
    "    n_cols,\n",
    "    figsize=(16, 5.2 * n_rows)\n",
    ")\n",
    "\n",
    "axes = np.atleast_1d(axes).flatten()\n",
    "\n",
    "for ax, category in zip(axes, categories):\n",
    "\n",
    "    category_data = (\n",
    "        category_product[\n",
    "            category_product[\"category\"] == category\n",
    "        ]\n",
    "        .sort_values(\n",
    "            \"revenue_share\",\n",
    "            ascending=True\n",
    "        )\n",
    "    )\n",
    "\n",
    "    colors = [\n",
    "        product_colors[product]\n",
    "        for product in category_data[\"product_name\"]\n",
    "    ]\n",
    "\n",
    "    bars = ax.barh(\n",
    "        category_data[\"product_name\"],\n",
    "        category_data[\"revenue_share\"],\n",
    "        color=colors,\n",
    "        height=0.65,\n",
    "        edgecolor=\"white\",\n",
    "        linewidth=1.2\n",
    "    )\n",
    "\n",
    "    ax.set_title(\n",
    "        category,\n",
    "        loc=\"left\",\n",
    "        fontsize=15,\n",
    "        fontweight=\"bold\",\n",
    "        color=\"#102A43\",\n",
    "        pad=12\n",
    "    )\n",
    "\n",
    "    ax.set_xlabel(\n",
    "        \"Share of Category Revenue (%)\",\n",
    "        fontsize=9,\n",
    "        color=\"#102A43\"\n",
    "    )\n",
    "\n",
    "    for bar, (_, row) in zip(\n",
    "        bars,\n",
    "        category_data.iterrows()\n",
    "    ):\n",
    "\n",
    "        share = row[\"revenue_share\"]\n",
    "        revenue_m = row[\"revenue\"] / 1_000_000\n",
    "\n",
    "        ax.text(\n",
    "            share + 0.35,\n",
    "            bar.get_y() + bar.get_height() / 2,\n",
    "            f\"{share:.1f}%  |  ₹{revenue_m:.1f}M\",\n",
    "            va=\"center\",\n",
    "            fontsize=8.5,\n",
    "            fontweight=\"bold\",\n",
    "            color=\"#102A43\"\n",
    "        )\n",
    "\n",
    "    ax.spines[\"top\"].set_visible(False)\n",
    "    ax.spines[\"right\"].set_visible(False)\n",
    "    ax.spines[\"left\"].set_visible(False)\n",
    "\n",
    "    ax.grid(\n",
    "        axis=\"x\",\n",
    "        alpha=0.20,\n",
    "        linewidth=0.8\n",
    "    )\n",
    "\n",
    "    ax.set_axisbelow(True)\n",
    "\n",
    "    ax.tick_params(\n",
    "        axis=\"y\",\n",
    "        length=0,\n",
    "        labelsize=9\n",
    "    )\n",
    "\n",
    "    ax.tick_params(\n",
    "        axis=\"x\",\n",
    "        labelsize=8\n",
    "    )\n",
    "\n",
    "for ax in axes[n_categories:]:\n",
    "    ax.remove()\n",
    "\n",
    "fig.suptitle(\n",
    "    \"Product Revenue Contribution Across Retail Categories\",\n",
    "    fontsize=20,\n",
    "    fontweight=\"bold\",\n",
    "    color=\"#102A43\",\n",
    "    x=0.08,\n",
    "    ha=\"left\",\n",
    "    y=0.995\n",
    ")\n",
    "\n",
    "fig.text(\n",
    "    0.08,\n",
    "    0.965,\n",
    "    \"Each product is assigned a distinct color; labels show revenue share and total revenue\",\n",
    "    fontsize=10,\n",
    "    color=\"#52606D\"\n",
    ")\n",
    "\n",
    "plt.tight_layout(\n",
    "    rect=[0, 0, 1, 0.94]\n",
    ")\n",
    "\n",
    "plt.show()"
   ]
  },
